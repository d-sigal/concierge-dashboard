# Copy to .env.local. Every variable is optional:
# with nothing set, the dashboard runs in demo mode with fake data and no login.

# --- Backend --------------------------------------------------------------
# REST API base URL. Leave empty for demo mode (in-memory mock API).
NEXT_PUBLIC_API_URL=
# WebSocket base URL for live conversation and message updates.
NEXT_PUBLIC_WS_URL=

# --- Auth (Clerk) ---------------------------------------------------------
# Leave empty to skip login entirely (demo mode or a backend without auth).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional JWT template name used when requesting tokens for your backend.
NEXT_PUBLIC_CLERK_TOKEN_TEMPLATE=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- WhatsApp onboarding (Meta embedded signup) ---------------------------
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_FACEBOOK_CONFIG_ID=

# --- Website widget -------------------------------------------------------
# Script that customers paste into their site to load the chat widget.
NEXT_PUBLIC_WIDGET_SCRIPT_URL=

# --- Links (features hide themselves when unset) --------------------------
NEXT_PUBLIC_BILLING_URL=
NEXT_PUBLIC_ONBOARDING_CALL_URL=
NEXT_PUBLIC_TERMS_URL=

# --- Branding -------------------------------------------------------------
NEXT_PUBLIC_PRODUCT_NAME=Concierge
NEXT_PUBLIC_SUPPORT_EMAIL=
